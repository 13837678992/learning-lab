{
  "name": "router-title-jump",
  "displayName": "路由标题跳转",
  "description": "输入中文路由 title，快速跳转到对应路由配置",
  "version": "1.0.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:router-jump.jumpByTitle"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test",
    "build": "node esbuild.js --production",
    "build:dev": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies",
    "check": "npm run lint && npm run typecheck && npm run test",
    "bench": "node scripts/bench.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "router-jump.jumpByTitle",
        "title": "根据路由 Title 跳转"
      }
    ],
    "keybindings": [
      {
        "command": "router-jump.jumpByTitle",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      }
    ],
    "configuration": {
      "title": "Router Title Jump",
      "properties": {
        "routerJump.routerGlobs": {
          "type": "array",
          "default": [
            "**/router/**/*.{js,ts,jsx,tsx}",
            "**/routers/**/*.{js,ts,jsx,tsx}",
            "**/src/router/**/*.{js,ts,jsx,tsx}"
          ],
          "items": {
            "type": "string"
          },
          "description": "用于扫描路由 title 的文件 glob 模式"
        },
        "routerJump.exclude": {
          "type": "string",
          "default": "**/{node_modules,dist,build,out,.git}/**",
          "description": "扫描路由文件时排除的路径"
        }
      }
    }
  },
  "volta": {
    "node": "20.15.0"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "pinyin-pro": "^3.28.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/vscode": "~1.70.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "typescript": "^7.0.2"
  }
}
