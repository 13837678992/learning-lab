{
  "name": "@fmac/app-main",
  "version": "0.0.0",
  "private": true,
  "description": "FMAC 微前端主应用（Vue2 + qiankun 基座，webpack 4 构建，经 @fmac/core 接入平台能力）",
  "scripts": {
    "dev": "NODE_OPTIONS=--openssl-legacy-provider webpack-dev-server --mode development",
    "build": "NODE_OPTIONS=--openssl-legacy-provider webpack --mode production",
    "build:test": "NODE_OPTIONS=--openssl-legacy-provider APP_MODE=test webpack --mode production"
  },
  "dependencies": {
    "@fmac/constants": "workspace:*",
    "@fmac/core": "workspace:*",
    "@fmac/env": "workspace:*",
    "element-ui": "2.15.14",
    "vue": "^2.7.16",
    "vue-router": "^3.6.5"
  },
  "devDependencies": {
    "@babel/core": "7.24.0",
    "@babel/preset-env": "7.24.0",
    "babel-loader": "8.3.0",
    "css-loader": "5.2.7",
    "file-loader": "6.2.0",
    "html-webpack-plugin": "4.5.2",
    "vue-loader": "15.11.1",
    "vue-style-loader": "4.1.3",
    "vue-template-compiler": "2.7.16",
    "webpack": "4.47.0",
    "webpack-cli": "3.3.12",
    "webpack-dev-server": "3.11.3"
  }
}
