    "file-loader": "6.2.0",
    "html-webpack-plugin": "4.5.2",
    "vue-loader": "15.11.1",
    "vue-style-loader": "4.1.3",
    "vue-template-compiler": "2.7.16",
    "webpack": "4.47.0",
    "webpack-cli": "3.3.12",
    "webpack-dev-server": "3.11.3"
  }
